# Copy to .env for persistent Compose settings. This is not the service env file.
# Keep loopback for local/reverse-proxy use; use 0.0.0.0 for a trusted LAN.
BIND_ADDRESS=127.0.0.1
PORT=8080

# Default: Docker-managed named volume and image's non-root UID/GID.
DATA_DIR=subscription-data
APP_UID=10001
APP_GID=10001

# For NAS storage under this project: set DATA_DIR=./data, create data/ yourself,
# and set APP_UID / APP_GID to its owner's `id -u` / `id -g` values.
